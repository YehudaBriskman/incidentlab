{
  "name": "incidentlab-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:server": "node --test --experimental-strip-types \"server/test/*.test.ts\"",
    "test:client": "node --test --experimental-strip-types \"src/explorer/*.test.ts\" \"src/components/*.test.ts\" \"src/lib/*.test.ts\""
  },
  "dependencies": {
    "@netlify/blobs": "11.1.9",
    "@netlify/functions": "6.1.1",
    "marked": "18.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
